# Northwind Dispatch Agent — see spec §3.3
# Copy to .env.local for development. Set the same values in Vercel for production.

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=      # HMAC verification of the post-call webhook

# Shared secret required on /api/tools/* AND /api/conversation-init.
# ElevenLabs does NOT sign the conversation-init webhook, only the post-call one,
# so this header is the only thing standing in front of a customer lookup that
# returns a name and a home address. Configure it as a custom header on both the
# workspace webhook and each webhook tool definition.
TOOL_SHARED_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never NEXT_PUBLIC_

# Cal.com
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=

# Slack incoming webhook for the on-call channel
SLACK_WEBHOOK_URL=

# Resend — confirmations go by email, not SMS (spec §6).
# onboarding@resend.dev sends to your own address with no domain verification.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Where bookings go when the caller is not a known customer. Must be a real,
# deliverable address: Cal.com rejects the booking if it cannot receive mail.
NORTHWIND_DISPATCH_EMAIL=
